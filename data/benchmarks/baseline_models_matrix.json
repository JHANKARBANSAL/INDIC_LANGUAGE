      "en",
      "hi-en",
      "mr",
      "hi",
      "bn",
      "ta",
      "te"
    ],
    "metrics_description": {
      "execution_accuracy_pct": "Percentage of generated SQL queries whose execution result multiset exactly matches gold ground truth (Execution Accuracy / EX)",
      "schema_f1": "Harmonic mean of precision and recall for predicted database tables and columns against ground truth",
      "indic_to_english_gap_delta_pct": "Accuracy degradation between English and average Indic languages: (EX_en - EX_indic_avg). Lower is better (0% represents perfect language parity)",
      "avg_latency_ms": "Average end-to-end execution latency in milliseconds per query",
      "cost_per_1k_queries_usd": "Inference token cost in USD per 1,000 queries"
    }
  },
